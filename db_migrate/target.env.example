# ==================================================================
# db_migrate/target.env —— 目标库（新站）连接配置【可选】
# ------------------------------------------------------------------
# 用途：影子库试跑。
#
#   - 本文件【不存在】时，工具自动使用 backend/.env 的 DB_*  → 连正式新库
#   - 本文件【存在】时，优先使用本文件的 DB_*                → 连你指定的库
#
# 典型用法（推荐流程）：
#   1) 克隆一份正式库当影子库：
#        mysqldump -u root -p --no-data 正式库名 | mysql -u root -p -e "CREATE DATABASE shadow_new"
#        mysqldump -u root -p 正式库名 | mysql -u root -p shadow_new
#   2) 复制本文件为 target.env，把 DB_NAME 改成 shadow_new
#   3) php db_migrate/30_迁移.php --execute     ← 写入的是 shadow_new，正式库毫发无损
#   4) php db_migrate/40_校验.php               ← 在影子库上对账
#   5) 全部通过后，删掉 target.env，再对正式库执行同一份 mapping
#        rm -f db_migrate/target.env
#        php db_migrate/30_迁移.php --execute
#
# 权限：640/600，迁移结束后删除。
# ==================================================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shadow_new
DB_USER=root
DB_PASS=请填入口令
