# ==================================================================
# db_migrate/source.env  —— 老库（源库）连接配置
# ------------------------------------------------------------------
# 复制本文件为 source.env 后填写真实值：
#     cp db_migrate/source.env.example db_migrate/source.env
#     chmod 600 db_migrate/source.env
#
# ★ 推荐做法（最安全）：先导出老库快照、在新站服务器上建一个 old_snapshot 库，
#   本文件就指向【本机的快照库】，与老站生产库完全隔离。
#       SRC_DB_HOST=127.0.0.1
#       SRC_DB_NAME=old_snapshot
#
# ★ 直连做法：把 SRC_DB_HOST 指向老库地址，账号务必用 00_老库只读账号.sql 建的那个。
#
# ★ 安全要求：
#   - 本文件含口令，权限设 640/600，属主为运行脚本的用户
#   - 【绝对不要】放进 Web 目录，也不要提交到版本库
#   - 迁移完成后立即删除本文件
#
# 迁移工具已经会强制把源库连接置为 READ ONLY，
# 这里再配一个只读账号就形成双重保险。
# ==================================================================

SRC_DB_HOST=127.0.0.1
SRC_DB_PORT=3306
SRC_DB_NAME=old_snapshot
SRC_DB_USER=dump_ro
SRC_DB_PASS=请填入只读账号口令

# 老库字符集：utf8mb4 / utf8 / gbk / latin1
# 填错会导致中文乱码。查看方法：
#   SELECT DEFAULT_CHARACTER_SET_NAME FROM information_schema.SCHEMATA
#   WHERE SCHEMA_NAME='老库名';
# 如果老库是 latin1 但实际存的是 GBK 字节（老 PHP 站常见），填 gbk。
SRC_CHARSET=utf8mb4
