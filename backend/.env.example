APP_ENV=production
APP_DEBUG=false
APP_SECRET=change_this_to_your_random_secret_key

# 本地业务主数据库 (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# 外部数据源 (SQL Server，选配)
SQLSRV_HOST=127.0.0.1
SQLSRV_PORT=1433
SQLSRV_DB=your_db_name
SQLSRV_USER=your_db_user
SQLSRV_PASS=your_db_password

# 外部生产排产/追踪库 (MES MySQL，选配)
MES_DB_HOST=127.0.0.1
MES_DB_PORT=3306
MES_DB_NAME=your_db_name
MES_DB_USER=your_db_user
MES_DB_PASS=your_db_password

# 外部 CEM 质量追溯系统凭据（★ 必填，请勿提交到版本库）
# 也可改用 backend/config/cem.local.php（已被 .gitignore 排除）
CEM_HOST=http://cem.ieslab.cn
CEM_USER=your_cem_user
CEM_PASS=your_cem_password

# 允许跨域的前端来源（逗号分隔，留空则仅允许内置的 ieslab.com）
CORS_ORIGINS=https://ieslab.com,https://www.ieslab.com

# BarTender 标签打印服务 API 地址（标签打印模块用；未部署该服务可留空）
PRINT_API_URL=http://127.0.0.1:8080/api/print

# 登录失败限速：窗口内最大失败次数 / 锁定窗口（秒）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW=600

# 会话空闲超时（秒），默认 8 小时
SESSION_IDLE_TIMEOUT=28800

# ★ 导出 / 工具箱转换接口限流（L5）：窗口内最大次数 / 窗口（秒）
# 转换类（PDF→Word、批量二维码）CPU 最重 → 阈值最紧；导出类（Excel 生成）次之。
# 设为 RATE_LIMIT_ENABLED=0 可整体关闭限流。
RATE_LIMIT_ENABLED=1
RATE_CONVERT_MAX=3
RATE_CONVERT_WINDOW=60
RATE_EXPORT_MAX=30
RATE_EXPORT_WINDOW=60
