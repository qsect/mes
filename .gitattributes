# ============================================================
# 换行符策略：本项目最终部署到 Linux（/www/wwwroot/vite），
# 源码一律以 LF 存储、以 LF 检出。
#
# 不加这个文件、而本机 core.autocrlf=true 时，git checkout / git stash 恢复
# 之后 .sh 会变成 CRLF；上传到服务器执行就会报
#   /bin/bash^M: bad interpreter
# 或 `if [ ... ]; then\r` 这类语法错误 —— 属于"本地看不出来、服务器才炸"的坑。
# ============================================================

* text=auto eol=lf

# 显式钉死关键脚本类型（text=auto 已覆盖，这里是给读代码的人看的意图声明）
*.sh    text eol=lf
*.php   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.vue   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.conf  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.env.example text eol=lf

# ============================================================
# 二进制：禁止 git 做任何换行符转换，否则文件会被静默损坏
# ============================================================
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.xlsx  binary
*.xls   binary
*.pdf   binary
*.zip   binary
*.ico   binary

# 验证产物差异时不要展示巨大的 lock/generated 文件
package-lock.json -diff
